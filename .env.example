# KhelaTV — independent sports news platform
# Copy this file to .env.local (never commit real secrets).
# Do NOT reuse The Connect / connect-bangla-news production credentials.

# --- Site ---
SITE_URL=https://khelatv.com
PUBLIC_SITE_URL=https://khelatv.com
VITE_SITE_URL=https://khelatv.com

# --- Supabase (new KhelaTV project only) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# --- Gemini (article, research, captions, cover images) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_COVER_PROMPT_MODEL=gemini-3.5-flash-lite

# Optional OpenAI fallback for article generation
# OPENAI_API_KEY=

# --- Facebook Page publishing (human approval still required) ---
META_ACCESS_TOKEN=
META_PAGE_ID=

# --- Cron (GitHub Actions + Vercel backup) ---
# Set the same value in:
#   1. Vercel env: DESK_CRON_SECRET (or CRON_SECRET)
#   2. GitHub repo secret: DESK_CRON_SECRET
DESK_CRON_SECRET=
CRON_SECRET=

# --- Optional image hosting ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
